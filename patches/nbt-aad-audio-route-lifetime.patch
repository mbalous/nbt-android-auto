-AudioRoute::AudioRoute() : gen_(0), buildBusy_(false), busyGen_(0) { pthread_mutex_init(&lock_, NULL); }
+AudioRoute::AudioRoute() : workers_(0), gen_(0), buildBusy_(false), busyGen_(0) {
+    pthread_mutex_init(&lock_, NULL);
+    pthread_cond_init(&idle_, NULL);
+}
+
+AudioRoute::~AudioRoute() {
+    cancelPending();
+    waitIdle();
+    pthread_cond_destroy(&idle_);
+    pthread_mutex_destroy(&lock_);
+}
+
+void AudioRoute::waitIdle() {
+    pthread_mutex_lock(&lock_);
+    while (workers_) pthread_cond_wait(&idle_, &lock_);
+    pthread_mutex_unlock(&lock_);
+}
+
+void AudioRoute::workerFinished() {
+    pthread_mutex_lock(&lock_);
+    if (--workers_ == 0) pthread_cond_broadcast(&idle_);
+    pthread_mutex_unlock(&lock_);
+}

