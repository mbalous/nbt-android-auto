 #include "audio/aa_media_msgs.hpp"
+#include "audio/aa_media_meta.hpp"
+
+// NBT fork (2026-11-19): the phone's now-playing information for the instrument cluster / HUD, written atomically to
+// RAM: "state=<1 stopped|2 playing|3 paused>", "song=", "artist=". The metadata is kept between calls so a state change
+// rewrites the same title. Only when NBT_NOWPLAYING_FILE is set (native_service sets it).
+static void writeNowPlaying(const nbt::AaMediaMetadata* md, uint32_t state) {
+    static std::string song, artist;
+    const char* path = getenv("NBT_NOWPLAYING_FILE");
+    if (!path || strncmp(path, "/fs/ram3/", 9)) return;
+    if (md) { song = md->song.substr(0, 120); artist = md->artist.substr(0, 120); }
+    for (size_t i = 0; i < song.size(); ++i) if (song[i] == '\n' || song[i] == '\r') song[i] = ' ';
+    for (size_t i = 0; i < artist.size(); ++i) if (artist[i] == '\n' || artist[i] == '\r') artist[i] = ' ';
+    std::string tmp = std::string(path) + ".tmp";
+    FILE* f = fopen(tmp.c_str(), "w");
+    if (!f) return;
+    fprintf(f, "state=%u\nsong=%s\nartist=%s\n", state == 0xFFFFFFFFu ? 0u : state, song.c_str(), artist.c_str());
+    fclose(f);
+    rename(tmp.c_str(), path);
+}
